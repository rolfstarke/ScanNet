+static void stopBundlingThread()
+{
+#ifdef RUN_MULTITHREADED
+    if ( !bundlingThread || !bundlingThread->joinable() ) return;
+    g_bundler->exitBundlingThread();
+
+    ConditionManager::lockImageManagerFrameReady ( ConditionManager::Recon );
+    while ( g_imageManager->hasBundlingFrameRdy() ) //bundling must have consumed the last frame
+    {
+        ConditionManager::waitImageManagerFrameReady ( ConditionManager::Recon );
+    }
+    g_imageManager->setBundlingFrameRdy();			//release all bundling locks
+    ConditionManager::unlockAndNotifyImageManagerFrameReady ( ConditionManager::Recon );
+    ConditionManager::lockBundlerProcessedInput ( ConditionManager::Recon );
+    g_bundler->confirmProcessedInputFrame();		//release all bundling locks
+    ConditionManager::unlockAndNotifyBundlerProcessedInput ( ConditionManager::Recon );
+
+    bundlingThread->join();	//wait for the bundling thread to return;
+    ConditionManager::release ( ConditionManager::Recon );
+#endif
+}
+
+static bool finiteTransform ( const mat4f& m )
+{
+    for ( unsigned int k = 0; k < 16; k++ )
+    {
+        if ( !std::isfinite ( m[k] ) ) return false;
+    }
+    return true;
+}
+
+// Never identity-backfill: frames with no finite transform get no file.
+static void saveOptimizedPoses ( const std::string& poseDir )
+{
+    TrajectoryManager* tm = g_bundler->getTrajectoryManager();
+    const std::vector<TrajectoryManager::TrajectoryFrame>& frames = tm->getFrames();
+    const unsigned int numAdded = tm->getNumAddedFrames();
+    const unsigned int numOpt = std::min ( tm->getNumOptimizedFrames(), numAdded );
+    unsigned int nOpt = 0, nInt = 0, nDrop = 0;
+    for ( unsigned int i = 0; i < numAdded; i++ )
+    {
+        const auto& f = frames[i];
+        const mat4f* t = nullptr;
+        if ( i < numOpt && finiteTransform ( f.optimizedTransform ) )
+        {
+            t = &f.optimizedTransform;
+            nOpt++;
+        }
+        else if ( finiteTransform ( f.integratedTransform ) )
+        {
+            t = &f.integratedTransform;
+            nInt++;
+        }
+        else
+        {
+            nDrop++;
+            continue;
+        }
+        std::ofstream s ( poseDir + "/" + std::to_string ( i ) + ".txt" );
+        s << std::setprecision ( 9 );
+        for ( unsigned int r = 0; r < 4; r++ )
+        {
+            s << ( *t ) [4*r] << " " << ( *t ) [4*r+1] << " " << ( *t ) [4*r+2] << " " << ( *t ) [4*r+3] << "\n";
+        }
+    }
+    std::cout << "[info] saved poses: " << nOpt << " optimized + " << nInt << " integrated, "
+              << nDrop << " dropped of " << numAdded << std::endl;
+}
+
+bool finishBundleFusion ( const std::string& poseDir, const std::string& meshPath, int rounds )
+{
+    cv::Mat none;
+    if ( rounds > 0 ) // rounds 0: no past-end solve is started at all
+    {
+        g_RGBDSensor->stopReceivingFrames();
+    }
+    for ( int r = 0; r < rounds; r++ )
+    {
+        processInputRGBDFrame ( none, none );
+    }
+    stopBundlingThread();
+    saveOptimizedPoses ( poseDir ); // BEFORE the drain: it overwrites integratedTransform
+
+    TrajectoryManager* tm = g_bundler->getTrajectoryManager();
+    const unsigned int maxPasses = 2 * tm->getNumAddedFrames() + 100; // bounded: never hang here
+    for ( unsigned int pass = 0; pass < maxPasses; pass++ )
+    {
+        reintegrate();
+        if ( tm->getNumActiveOperations() == 0 ) break;
+    }
+    return saveMeshIntoFile ( meshPath, true );
+}
