+// Headless BundleFusion: <app.txt> <bundling.txt> <in_dir> <out_dir> <rounds>
+// in_dir/color/<i>.jpg + in_dir/depth/<i>.png (640x480, 16-bit depth in mm).
+// Writes out_dir/pose/<i>.txt and out_dir/mesh.ply.
+#include <BundleFusion.h>
+#include <dirent.h>
+#include <sys/stat.h>
+#include <algorithm>
+#include <iostream>
+#include <string>
+#include <vector>
+#include <opencv2/opencv.hpp>
+
+static std::vector<int> listFrames(const std::string& dir)
+{
+    std::vector<int> ids;
+    DIR* d = opendir(dir.c_str());
+    if (!d) return ids;
+    while (dirent* e = readdir(d))
+    {
+        const std::string n(e->d_name);
+        if (n.size() > 4 && n.compare(n.size() - 4, 4, ".jpg") == 0)
+            ids.push_back(std::stoi(n));
+    }
+    closedir(d);
+    std::sort(ids.begin(), ids.end());
+    return ids;
+}
+
+int main(int argc, char** argv)
+{
+    if (argc != 6)
+    {
+        std::cerr << "usage: bundle_fusion_headless <app.txt> <bundling.txt> <in_dir> <out_dir> <rounds>" << std::endl;
+        return 2;
+    }
+    const std::string in = argv[3], out = argv[4];
+    const int rounds = std::stoi(argv[5]);
+    const std::vector<int> ids = listFrames(in + "/color");
+    if (ids.empty())
+    {
+        std::cerr << "no frames in " << in << "/color" << std::endl;
+        return 2;
+    }
+    if (!initBundleFusion(argv[1], argv[2]))
+    {
+        std::cerr << "BundleFusion init failed" << std::endl;
+        return 1;
+    }
+    size_t processed = 0;
+    for (const int i : ids)
+    {
+        const std::string name = std::to_string(i);
+        cv::Mat rgb = cv::imread(in + "/color/" + name + ".jpg");
+        cv::Mat depth = cv::imread(in + "/depth/" + name + ".png", cv::IMREAD_UNCHANGED);
+        if (rgb.empty() || depth.empty() || rgb.cols != 640 || rgb.rows != 480
+            || depth.cols != 640 || depth.rows != 480 || depth.type() != CV_16UC1)
+        {
+            std::cout << "[warn] skipping frame " << i << std::endl;
+            continue;
+        }
+        if (!processInputRGBDFrame(rgb, depth))
+        {
+            std::cout << "[warn] skipping frame " << i << std::endl;
+            continue;
+        }
+        processed++;
+    }
+    std::cout << "[info] processed " << processed << "/" << ids.size() << " frames" << std::endl;
+    mkdir((out + "/pose").c_str(), 0775);
+    const bool ok = finishBundleFusion(out + "/pose", out + "/mesh.ply", rounds);
+    deinitBundleFusion();
+    std::cout << "[info] done" << std::endl;
+    return ok ? 0 : 1;
+}
